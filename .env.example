# --- App ---
APP_NAME="Burn Segmentation API"
ENV=development

# --- Storage backend selection: "s3" or "azure" ---
STORAGE_PROVIDER=s3

# --- S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# --- Azure Blob ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=

# --- Model / inference ---
MODEL_CHECKPOINT_PATH=weights/fusion_deeplab.pt
MODEL_ENCODER_NAME=resnet34
MODEL_NUM_CLASSES=3
MODEL_ALPHA=0.5
MODEL_DEVICE=cuda
MODEL_INPUT_SIZE=768
